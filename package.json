{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "description": "A workspace that reconstructs your exact operational state across devices, crashes, and offline gaps.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,sync -c cyan,magenta \"vite\" \"npm:sync\"",
    "sync": "tsx watch server/index.ts",
    "sync:prod": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lib0": "^0.2.97",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "ws": "^8.18.0"
  }
}
