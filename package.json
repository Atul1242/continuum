{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "description": "A workspace that reconstructs your exact operational state across devices, crashes, and offline gaps.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm:server\"",
    "server": "tsx watch server/index.ts",
    "server:prod": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.1.0",
    "fastify": "^5.12.8",
    "lib0": "^0.2.97",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "ws": "^8.18.0"
  }
}
